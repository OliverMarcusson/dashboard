[Unit]
Description=Oliver Server Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dashboard
Group=dashboard
WorkingDirectory=/opt/oliver-dashboard/backend
Environment=DASHBOARD_BIND=127.0.0.1:3000
Environment=DASHBOARD_DATABASE_URL=sqlite:///var/lib/oliver-dashboard/dashboard.sqlite?mode=rwc
Environment=DASHBOARD_RP_ID=dash.olivermarcusson.se
Environment=DASHBOARD_ORIGIN=https://dash.olivermarcusson.se
ExecStart=/usr/local/bin/dashboardd
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/oliver-dashboard

[Install]
WantedBy=multi-user.target
