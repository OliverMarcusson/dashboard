[Unit]
Description=Server dashboard
Documentation=https://dash.marcusson.dev
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/dashboardd serve
Restart=on-failure
RestartSec=3s

# Reaches the Docker socket, systemd over D-Bus, and host metrics, so it runs
# as root — the same privilege the host agent it replaces already held.
User=root
StateDirectory=dashboard
Environment=DASHBOARD_ADDR=127.0.0.1:13000
Environment=DASHBOARD_DB=/var/lib/dashboard/dashboard.sqlite
Environment=DASHBOARD_ORIGIN=https://dash.marcusson.dev

# Hardening that does not conflict with what the collectors need.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/dashboard
ProtectKernelTunables=yes
ProtectControlGroups=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
