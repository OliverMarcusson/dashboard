[Unit]
Description=Oliver Dashboard Host Agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
Environment=DASHBOARD_AGENT_BIND=172.17.0.1:13001
Environment=DASHBOARD_AGENT_TOKEN_FILE=/var/lib/oliver-dashboard/agent-token
ExecStart=/usr/local/bin/dashboard-agent
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
